NODE_ENV=development
PORT=5000
CLIENT_ORIGINS=http://localhost:3000
# Required: paste the Atlas driver connection URI into your ignored .env.
# URL-encode special characters in the database user's password.
MONGODB_URI=
MONGODB_DB=fixmate
# BetterAuth, JWT, ImgBB, and Stripe test-mode variables arrive with those features.


BETTER_AUTH_URL=http://localhost:5000
BETTER_AUTH_SECRET=
# Optional DNS override for environments with broken SRV resolution:
DNS_SERVERS=

# Independent random JWT signing secret, at least 32 characters.
JWT_SECRET=
